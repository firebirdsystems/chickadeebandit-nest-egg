{
  "id": "nest-egg",
  "contexts": ["household", "shared_space"],
  "name": "Nest Egg",
  "version": "1.0.0",
  "description": "Household financial overview — track net worth, savings goals, and named funds over time. Adults manage assets and liabilities; kids see their savings goals.",
  "entrypoint": "index.html",
  "runtime": "static",
  "category": "family",
  "tags": ["finance", "net-worth", "savings", "goals", "household"],
  "data_access": {
    "reads": ["family.members"],
    "writes": []
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "storage": "db",
    "member_references": {
      "savings_goals": {
        "column": "member_id",
        "on_removed": "delete",
        "dependent_tables": [
          {
            "table": "goal_snapshots",
            "foreign_key": "goal_id"
          }
        ]
      },
      "account_snapshots": {
        "column": "recorded_by",
        "on_removed": "keep"
      },
      "fund_snapshots": {
        "column": "recorded_by",
        "on_removed": "keep"
      },
      "goal_snapshots": {
        "column": "recorded_by",
        "on_removed": "keep"
      }
    },
  "row_policies": {
    "savings_goals": {
      "kind": "owner_or_visibility",
      "member_column": "member_id",
      "visibility_column": "visibility",
      "everyone_values": ["everyone"],
      "adult_values": ["adults", "everyone"]
    },
    "accounts": { "kind": "adult_only" },
    "account_snapshots": { "kind": "adult_only" },
    "funds": { "kind": "adult_only" },
    "fund_snapshots": { "kind": "adult_only" },
    "goal_snapshots": {
      "kind": "inherit_visibility",
      "fk_column": "goal_id",
      "parent_table": "savings_goals",
      "writer_column": "recorded_by"
    }
  },
  "delete_cascades": {
    "savings_goals": [
      { "table": "goal_snapshots", "foreign_key": "goal_id" }
    ]
  },
  "publish_acls": {
    "nest-egg.goal-reached": { "require_role": "adult" }
  },
  "publishes": ["nest-egg.goal-reached"],
  "nav": { "label": "Nest Egg" },
  "widget": { "label": "Nest Egg", "size": "small" },
  "resource_limits": { "max_db_bytes": 104857600 },
  "icon": "🪺"
}
